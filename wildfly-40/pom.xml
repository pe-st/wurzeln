<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ch.schlau.wurzeln.root</groupId>
        <artifactId>root</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>wildfly-40</artifactId>
    <packaging>pom</packaging>
    <name>${project.groupId}.${project.artifactId}</name>

    <properties>
        <wildfly.bom.version>40.0.1.Final</wildfly.bom.version>
        <wildfly.maven.plugin.version>${wildfly.plugin.version}</wildfly.maven.plugin.version>

        <expressly.version>6.0.0</expressly.version>
        <io.opentelemetry.instrumentation.version>2.14.0</io.opentelemetry.instrumentation.version>
        <io.opentelemetry.version>1.48.0</io.opentelemetry.version>
        <smallrye.health.version>4.3.0</smallrye.health.version>
        <smallrye.reactive-messaging.version>4.32.1</smallrye.reactive-messaging.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Server-provided versions must come from these BOMs, not local copies. -->
            <dependency>
                <groupId>org.wildfly.bom</groupId>
                <artifactId>wildfly-ee</artifactId>
                <version>${wildfly.bom.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
            <dependency>
                <!-- Keep this order; both BOMs manage overlapping RESTEasy artifacts. -->
                <groupId>org.wildfly.bom</groupId>
                <artifactId>wildfly-expansion</artifactId>
                <version>${wildfly.bom.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>

            <!-- Dependencies provided by Wildfly in private modules and therefore not exposed in the BOMs -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-annotations</artifactId>
                <version>${io.opentelemetry.instrumentation.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>org.glassfish.expressly</groupId>
                <artifactId>expressly</artifactId>
                <version>${expressly.version}</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>io.smallrye</groupId>
                <artifactId>smallrye-health</artifactId>
                <version>${smallrye.health.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- This one is funny (not):
               * smallrye-reactive-messaging-api is a rewrite of microprofile-reactive-messaging-api:
                 same interfaces in the same package, but with additional methods (e.g. org.eclipse.microprofile.reactive.messaging.Message#addMetadata)
               * Wildfly packages smallrye-reactive-messaging-api.jar as the microprofile-reactive-messaging-api module
               * The wildfly-expansion BOM exposes microprofile-reactive-messaging-api, not smallrye-reactive-messaging-api
               -->
            <dependency>
                <groupId>io.smallrye.reactive</groupId>
                <artifactId>smallrye-reactive-messaging-api</artifactId>
                <version>${smallrye.reactive-messaging.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Additional dependencies -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-extension-trace-propagators</artifactId>
                <version>${io.opentelemetry.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>dependencies-existence</id>
            <dependencies>
                <dependency>
                    <groupId>jakarta.annotation</groupId>
                    <artifactId>jakarta.annotation-api</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.microprofile.config</groupId>
                    <artifactId>microprofile-config-api</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-client-api</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.hibernate.orm</groupId>
                    <artifactId>hibernate-core</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.opentelemetry.instrumentation</groupId>
                    <artifactId>opentelemetry-instrumentation-annotations</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.glassfish.expressly</groupId>
                    <artifactId>expressly</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.smallrye</groupId>
                    <artifactId>smallrye-health</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.smallrye.reactive</groupId>
                    <artifactId>smallrye-reactive-messaging-api</artifactId>
                </dependency>
                <dependency>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-extension-trace-propagators</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
